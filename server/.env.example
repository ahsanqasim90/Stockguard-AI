NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Paste your MongoDB Atlas URI here:
MONGODB_URI=

# Atlas example:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/stockguard_ai?retryWrites=true&w=majority

# Local MongoDB alternative:
# MONGODB_URI=mongodb://127.0.0.1:27017/stockguard_ai

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ML_API_URL=http://127.0.0.1:8001

# Optional outbound email notifications (SMTP):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=StockGuard AI <notifications@example.com>

# Optional when Expo push access security is enabled for the EAS project:
EXPO_ACCESS_TOKEN=
