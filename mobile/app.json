{
  "expo": {
    "name": "StockGuard AI",
    "slug": "stockguard-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/stockguard-logo.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stockguardai.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/stockguard-logo.png"
      },
      "package": "com.stockguardai.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/stockguard-logo.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/stockguard-logo.png",
          "color": "#1fd4c0",
          "defaultChannel": "stockguard-alerts"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5600bbdb-9412-4e22-9a77-663983c2e2d7"
      }
    },
    "owner": "ahsanqasim2003"
  }
}
