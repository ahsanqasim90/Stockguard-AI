{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": ["bom1"],
  "installCommand": "npm --prefix server install && npm --prefix frontend install",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/models/production/**",
      "maxDuration": 60
    },
    "api/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/**,mobile/**,server/**,ml/**,data/**,tmp/**,work/**}"
    }
  },
  "rewrites": [
    { "source": "/ml", "destination": "/api/main" },
    { "source": "/api", "destination": "/api/index" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/invite/:path*", "destination": "/index.html" },
    { "source": "/reset-password/:path*", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/dashboard/:path*", "destination": "/index.html" }
  ]
}
